# Copy to .env and fill in. `make init` generates the Airflow keys automatically.

# --- AWS / Lakehouse ---
AWS_REGION=us-east-1
AWS_PROFILE=lakehouse-pipeline
LAKEHOUSE_BUCKET_NAME=lakehouse-dev-<account-id>

# --- Jupyter (spark-iceberg) ---
JUPYTER_TOKEN=

# --- Postgres ---
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse
POSTGRES_DB=airflow

# --- Airflow ---
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- Superset ---
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@example.com
